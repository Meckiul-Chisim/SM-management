# This app currently reads NO environment variables. It is a local-first frontend
# demo with no backend, so there is nothing to configure.
#
# These names are reserved for a possible future shared backend. Do not put real
# keys in this file, and never put a service-role key in a VITE_ variable
# (everything prefixed VITE_ is visible to anyone who opens the site).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
